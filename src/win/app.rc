#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APP ICON "app.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
PRODUCTVERSION  APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "find_mymouse_byshake"
            VALUE "FileDescription",  "Find My Mouse by Shake"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "find_mymouse_byshake"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "find_mymouse_byshake.exe"
            VALUE "ProductName",      "Find My Mouse by Shake"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
